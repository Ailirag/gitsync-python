# Образец файла окружения для docker/compose.yaml.
#
#   cp docker/env.example docker/.env      # затем поправьте пути под свою машину
#   docker compose --env-file docker/.env -f docker/compose.yaml config
#
# Сам файл .env в репозиторий не кладут: в нём пути и имена файлов с паролями.

# --- кто запускает ----------------------------------------------------------
# UID владельца каталогов на хосте. Обязан совпадать у ВСЕХ контейнеров, которые
# делят том блокировок: файл блокировки создаётся с правами 0600.
# Узнать свой:  id -u
GITSYNC_UID=1000
# ГРУППА 0 — это не «запуск от root». Каталоги внутри образа принадлежат app:0 и
# открыты на запись группе, поэтому с GID=0 работает ЛЮБОЙ UID: и тома, и HOME.
# Свой GID (например 1000) тоже можно — но тогда образ надо собрать под него:
#   docker build -f docker/Dockerfile.core --target core \
#     --build-arg APP_UID=$(id -u) --build-arg APP_GID=$(id -g) -t gitsync-py:core .
#
# ВАЖНО для службы push: ssh отказывается работать с UID, которого нет в
# /etc/passwd образа («No user exists for uid …»), — синхронизации это не мешает,
# а отправке мешает. Пользуетесь отправкой по ssh — соберите образ под свой
# UID/GID (команда выше) и укажите здесь свои номера.
GITSYNC_GID=0

# --- часовой пояс источника --------------------------------------------------
# Время версии приходит из хранилища без смещения и считается местным.
# Здесь указывается пояс машины, где работают разработчики 1С, а не пояс сервера.
SOURCE_TZ=Europe/Moscow

# --- пути на хосте -----------------------------------------------------------
# Linux:
REPO_HOST=/srv/gitsync/база
CONFIG_HOST=/srv/gitsync/конфигурация
FIXTURE_HOST=/srv/gitsync/фикстура
STORAGE_PASSWORD_FILE=/srv/gitsync/секреты/storage.txt
GIT_SSH_KEY_FILE=/srv/gitsync/секреты/id_ed25519
#
# Docker Desktop в Windows — пути хоста пишутся в стиле Windows, а цели внутри
# контейнера остаются линуксовыми (/repo, /config). Обратные слэши не нужны:
# REPO_HOST=D:/git/база
# CONFIG_HOST=D:/gitsync/конфигурация
# STORAGE_PASSWORD_FILE=D:/gitsync/секреты/storage.txt

# --- образы ------------------------------------------------------------------
CORE_IMAGE=gitsync-py:core
# Приватный образ с платформой 1С собирается на месте, см. docker/Dockerfile.native.
NATIVE_IMAGE=gitsync-py:native

# --- прочее ------------------------------------------------------------------
# Общий том блокировок. Менять имя нужно только если на хосте есть несколько
# независимых установок, которым нельзя мешать друг другу.
SESSIONS_VOLUME=gitsync-sessions
# Запас времени на остановку: текущий вызов конфигуратора не прерывается.
STOP_GRACE=70m
